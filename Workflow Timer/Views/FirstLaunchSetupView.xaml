<Window x:Class="Workflow_Timer.Views.FirstLaunchSetupView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Workflow Timer — First-launch setup"
        Icon="pack://application:,,,/Resources/Icons/Workflow_Timer.ico"
        Background="{DynamicResource WorkflowWindowBrush}" Foreground="{DynamicResource WorkflowTextBrush}"
        FontSize="15" Width="540" SizeToContent="Height" MinWidth="420"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="NoResize">
    <StackPanel Margin="20">
        <TextBlock Text="MAKE IT YOURS" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource WorkflowTimerAccentBrush}"/>
        <TextBlock Text="You're almost ready!" FontSize="26" FontWeight="Bold" Margin="0,4,0,8"/>
        <TextBlock Text="Choose how you want to launch Workflow Timer. Both options are optional and can be changed later in Settings." TextWrapping="Wrap" Margin="0,0,0,16"/>
        <Border Background="{DynamicResource WorkflowPanelBrush}" BorderBrush="{DynamicResource WorkflowCardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,10">
            <StackPanel>
                <CheckBox x:Name="ShortcutCheck" Content="Create desktop shortcut" FontWeight="SemiBold"/>
                <TextBlock Text="Open Workflow Timer directly from your desktop." TextWrapping="Wrap" Margin="24,5,0,0" Foreground="{DynamicResource WorkflowMutedBrush}"/>
            </StackPanel>
        </Border>
        <Border Background="{DynamicResource WorkflowPanelBrush}" BorderBrush="{DynamicResource WorkflowCardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,16">
            <StackPanel>
                <CheckBox x:Name="StartupCheck" Content="Start Workflow Timer with Windows" FontWeight="SemiBold"/>
                <TextBlock Text="Launch the app automatically when you sign in to Windows." TextWrapping="Wrap" Margin="24,5,0,0" Foreground="{DynamicResource WorkflowMutedBrush}"/>
            </StackPanel>
        </Border>
        <TextBlock x:Name="ErrorText" Foreground="{DynamicResource WorkflowErrorBrush}" TextWrapping="Wrap"/>
        <Button Content="Done" IsDefault="True" Style="{StaticResource WorkflowPrimaryButton}" HorizontalAlignment="Right" MinWidth="100" Click="Done_Click"/>
    </StackPanel>
</Window>
