<Window x:Class="Workflow_Timer.Views.SettingsView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Workflow Timer — Settings"
        Background="{DynamicResource WorkflowWindowBrush}"
        Foreground="{DynamicResource WorkflowTextBrush}"
        Icon="pack://application:,,,/Resources/Icons/Workflow_Timer.ico"
        Width="660" Height="740" MinWidth="520" MinHeight="380"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <TextBlock x:Name="ErrorText" Foreground="{DynamicResource WorkflowErrorBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/>
            <DockPanel LastChildFill="False">
                <Button DockPanel.Dock="Left" Content="Reset defaults" Padding="10,5"
                        Command="{Binding ResetDefaultsCommand}"/>
                <Button DockPanel.Dock="Right" Content="Cancel" Padding="12,5"
                        IsCancel="True" Command="{Binding CancelCommand}"/>
                <Button DockPanel.Dock="Right" Content="Save" Padding="12,5" Margin="0,0,8,0"
                        IsDefault="True" Command="{Binding SaveCommand}"/>
            </DockPanel>
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <TextBlock Text="Settings" FontSize="22" FontWeight="SemiBold"/>
                <TextBlock Text="Configure startup, widget placement, focus reminders, sounds and global keyboard shortcuts."
                           TextWrapping="Wrap" Margin="0,6,0,14"/>
                <GroupBox Header="Appearance" Margin="0,0,0,10">
                    <StackPanel Margin="10">
                        <TextBlock Text="Theme"/>
                        <ComboBox x:Name="ThemeBox" Margin="0,4,0,0"/>
                        <TextBlock Text="The theme changes when you save settings."
                                   TextWrapping="Wrap" Margin="0,5,0,0"/>
                    </StackPanel>
                </GroupBox>
                <GroupBox Header="Startup" Margin="0,0,0,10">
                    <StackPanel Margin="10">
                        <CheckBox x:Name="StartupCheck" Content="Start with Windows"/>
                        <TextBlock Text="Launch Workflow Timer when you sign in to Windows."
                                   TextWrapping="Wrap" Margin="0,5,0,0"/>
                        <CheckBox x:Name="TrayCheck" Content="Minimize to system tray" Margin="0,10,0,0"/>
                        <TextBlock Text="Minimizing hides the window; the tray icon restores it. Closing still exits."
                                   TextWrapping="Wrap" Margin="0,5,0,0"/>
                        <Button Content="Create Desktop Shortcut" Click="CreateDesktopShortcut_Click"
                                HorizontalAlignment="Left" Padding="10,5" Margin="0,10,0,0"/>
                        <TextBlock Text="Create or update the Workflow Timer shortcut on your desktop immediately."
                                   TextWrapping="Wrap" Margin="0,5,0,0"/>
                    </StackPanel>
                </GroupBox>
                <GroupBox Header="Widget" Margin="0,0,0,10">
                    <StackPanel Margin="10">
                        <TextBlock Text="Widget position"/>
                        <ComboBox x:Name="PositionBox" Margin="0,4,0,0" DisplayMemberPath="Value" SelectedValuePath="Key"/>
                        <TextBlock Text="Free drag: drag the widget by its top status label. Its position on the primary display is remembered."
                                   TextWrapping="Wrap" Margin="0,5,0,0"/>
                    </StackPanel>
                </GroupBox>
                <GroupBox Header="Focus reminders" Margin="0,0,0,10">
                    <StackPanel Margin="10">
                        <CheckBox x:Name="FocusCheck" Content="Remind me after the break ends" Margin="0,0,0,8"/>
                        <TextBlock Text="Show a persistent reminder when a break finishes naturally. Dismiss or snooze stops blinking temporarily; cancel stops reminders until the next completed break."
                                   TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <TextBlock Text="Reminder interval (minutes)"/>
                        <TextBox x:Name="IntervalBox" Margin="0,4,0,8"/>
                        <TextBlock Text="Snooze duration (minutes)"/>
                        <TextBox x:Name="SnoozeBox" Margin="0,4,0,0"/>
                    </StackPanel>
                </GroupBox>
                <GroupBox Header="Notification sounds" Margin="0,0,0,10">
                    <StackPanel Margin="10">
                        <TextBlock Text="Play Alarm.mp3 for timer completion and SnoozeAlert.mp3 for focus reminders. Missing or unreadable files use the Windows beep."
                                   TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <CheckBox x:Name="WorkSoundCheck" Content="Work timer completed" Margin="0,0,0,5"/>
                        <CheckBox x:Name="BreakSoundCheck" Content="Break timer completed" Margin="0,0,0,5"/>
                        <CheckBox x:Name="ReminderSoundCheck" Content="Focus reminder"/>
                    </StackPanel>
                </GroupBox>
                <GroupBox Header="Global keyboard shortcuts" Margin="0,0,0,10">
                    <StackPanel Margin="10">
                        <TextBlock Text="Choose one or two different modifiers, click the Key field and press a key without modifiers. Backspace clears it. Letters, numbers, numpad, arrows, navigation, F1–F11, Space and layout-specific punctuation are supported. Windows may reserve some combinations."
                                   TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <Grid Margin="0,0,0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="106"/>
                                <ColumnDefinition Width="2*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Modifier 1" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="1" Text="Modifier 2" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="2" Text="Key" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="3" Text="Action" FontWeight="SemiBold"/>
                        </Grid>
                        <ItemsControl x:Name="HotkeysList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="106"/>
                                            <ColumnDefinition Width="2*"/>
                                        </Grid.ColumnDefinitions>
                                        <ComboBox Grid.Column="0" Margin="0,0,6,0"
                                                  ItemsSource="{Binding FirstModifiers, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  SelectedItem="{Binding Modifier1, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                        <ComboBox Grid.Column="1" Margin="0,0,6,0"
                                                  ItemsSource="{Binding SecondModifiers, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  SelectedItem="{Binding Modifier2, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                        <TextBox x:Name="HotkeyKeyBox" Grid.Column="2" Margin="0,0,6,0"
                                                 IsReadOnly="True" HorizontalContentAlignment="Center"
                                                 Text="{Binding DisplayKey, Mode=OneWay}"
                                                 PreviewKeyDown="HotkeyKey_PreviewKeyDown"
                                                 ToolTip="Press a key. Backspace clears the shortcut."/>
                                        <TextBlock Grid.Column="3" Text="{Binding ActionName}" TextWrapping="Wrap"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Content="Clear all shortcuts" HorizontalAlignment="Left" Margin="0,8,0,0"
                                Padding="8,4" Click="ClearHotkeys_Click"/>
                    </StackPanel>
                </GroupBox>
                <GroupBox Header="Data management" Margin="0,0,0,10">
                    <StackPanel Margin="10">
                        <TextBlock Text="Open the application data folder to make manual backups of your presets, tasks, history and settings."
                                   TextWrapping="Wrap" Margin="0,0,0,6"/>
                        <Button Content="Open Folder" Click="OpenDataFolder_Click" HorizontalAlignment="Left" Padding="10,5"/>
                        <TextBlock Text="Delete saved application data and restart with factory defaults. This cannot be undone."
                                   TextWrapping="Wrap" Margin="0,12,0,6"/>
                        <Button Content="Delete Data..." Click="DeleteData_Click" HorizontalAlignment="Left" Padding="10,5"
                                Foreground="{DynamicResource WorkflowErrorBrush}"/>
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
