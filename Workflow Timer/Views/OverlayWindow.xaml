<Window x:Class="Workflow_Timer.Views.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Workflow Timer Overlay"
        Width="300" Height="222" FontSize="14"
        WindowStyle="None" ResizeMode="NoResize"
        ShowInTaskbar="False" Topmost="True"
        Background="Transparent" Foreground="{DynamicResource WorkflowTextBrush}" AllowsTransparency="True">
    <Border Background="{DynamicResource WorkflowOverlayBrush}" BorderBrush="{DynamicResource WorkflowOverlayBorderBrush}"
            BorderThickness="2" CornerRadius="10" Padding="14">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock ToolTipService.InitialShowDelay="450" ToolTipService.ShowDuration="20000" ToolTipService.ShowOnDisabled="True" ToolTip="Current timer state. Drag here to move the widget when Free drag is enabled." x:Name="StateText" Grid.Row="0" Text="WORKING"
                       FontSize="14" FontWeight="Bold" TextAlignment="Center"
                       Background="Transparent" MouseLeftButtonDown="StateText_MouseLeftButtonDown"/>
            <Grid Grid.Row="1" Margin="0,2,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock ToolTipService.InitialShowDelay="450" ToolTipService.ShowDuration="20000" ToolTipService.ShowOnDisabled="True" ToolTip="Time remaining. Drag the countdown to move the widget when Free drag is enabled." x:Name="TimeText" Text="00:00:00" Foreground="{DynamicResource WorkflowTimerAccentBrush}"
                           FontSize="32" FontWeight="Bold" TextAlignment="Center" VerticalAlignment="Center"
                           Background="Transparent" MouseLeftButtonDown="StateText_MouseLeftButtonDown"/>
                <Button ToolTipService.InitialShowDelay="450" ToolTipService.ShowDuration="20000" ToolTipService.ShowOnDisabled="True" x:Name="CompactButton" Grid.Column="1" Content="−" FontSize="16" Width="28" Height="28"
                        MinWidth="0" Padding="0" VerticalAlignment="Center" Margin="4,0,0,0"
                        ToolTip="Switch between the compact timer and full widget." Click="CompactButton_Click"/>
            </Grid>
            <StackPanel x:Name="ActionPanel" Grid.Row="2" Margin="0,0,0,8">
                <TextBlock ToolTipService.InitialShowDelay="450" ToolTipService.ShowDuration="20000" ToolTipService.ShowOnDisabled="True" ToolTip="The next scheduled action that will open automatically." Text="NEXT ACTION" FontSize="12" FontWeight="Bold"
                           Foreground="{DynamicResource WorkflowMutedBrush}" HorizontalAlignment="Center"/>
                <TextBlock ToolTipService.InitialShowDelay="450" ToolTipService.ShowDuration="20000" ToolTipService.ShowOnDisabled="True" x:Name="NextActionNameText" Text="No upcoming actions"
                           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                           FontSize="13" FontWeight="SemiBold"
                           HorizontalAlignment="Stretch" TextAlignment="Center"
                           ToolTip="No upcoming actions"/>
                <TextBlock ToolTipService.InitialShowDelay="450" ToolTipService.ShowDuration="20000" ToolTipService.ShowOnDisabled="True" ToolTip="Time until the next scheduled action launches." x:Name="NextActionTimeText" Text="--:--:--"
                           FontSize="18" FontWeight="Bold" TextAlignment="Center"/>
            </StackPanel>
            <Button ToolTipService.InitialShowDelay="450" ToolTipService.ShowDuration="20000" ToolTipService.ShowOnDisabled="True" ToolTip="Pause or resume the active timer." x:Name="PauseResumeButton" Grid.Row="3" Content="Pause" Style="{StaticResource WorkflowPrimaryButton}"
                    Width="112" Height="32" Padding="6,3" HorizontalAlignment="Center"
                    Click="PauseResumeButton_Click"/>
        </Grid>
    </Border>
</Window>
