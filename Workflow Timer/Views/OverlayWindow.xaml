<Window x:Class="Workflow_Timer.Views.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Workflow Timer Overlay"
        Width="300" Height="222"
        WindowStyle="None" ResizeMode="NoResize"
        ShowInTaskbar="False" Topmost="True"
        Background="Transparent" AllowsTransparency="True">
    <Border Background="#EDEDED" BorderBrush="#202020"
            BorderThickness="2" CornerRadius="10" Padding="14">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock x:Name="StateText" Grid.Row="0" Text="WORKING"
                       FontSize="14" FontWeight="Bold" TextAlignment="Center"/>
            <TextBlock x:Name="TimeText" Grid.Row="1" Text="00:00:00"
                       FontSize="32" FontWeight="Bold" TextAlignment="Center"
                       Margin="0,2,0,8"/>
            <StackPanel Grid.Row="2" Margin="0,0,0,8">
                <TextBlock Text="NEXT ACTION" FontSize="10" FontWeight="Bold"
                           Foreground="#505050" HorizontalAlignment="Center"/>
                <TextBlock x:Name="NextActionNameText" Text="No upcoming actions"
                           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                           FontSize="12" FontWeight="SemiBold"
                           HorizontalAlignment="Stretch" TextAlignment="Center"
                           ToolTip="No upcoming actions"/>
                <TextBlock x:Name="NextActionTimeText" Text="--:--:--"
                           FontSize="18" FontWeight="Bold" TextAlignment="Center"/>
            </StackPanel>
            <Button x:Name="PauseResumeButton" Grid.Row="3" Content="Pause"
                    Width="112" Height="27" HorizontalAlignment="Center"
                    Click="PauseResumeButton_Click"/>
        </Grid>
    </Border>
</Window>
