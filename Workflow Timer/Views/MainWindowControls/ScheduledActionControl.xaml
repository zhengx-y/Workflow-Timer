<UserControl x:Class="Workflow_Timer.Views.MainWindowControls.ScheduledActionControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="6"
            Padding="12" Margin="0,8,0,0">
        <StackPanel>
            <TextBlock Text="Scheduled Actions" FontSize="18" FontWeight="Bold"
                       Margin="0,0,0,8" />

            <ListBox ItemsSource="{Binding ScheduledActions}"
                     SelectedItem="{Binding SelectedScheduledAction, Mode=TwoWay}"
                     MaxHeight="180" MinHeight="65"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                     HorizontalContentAlignment="Left"
                     Margin="0,0,0,10">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="3,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="80" />
                            </Grid.ColumnDefinitions>
                            <!-- Click to toggle and immediately save this action's Enabled state. -->
                            <CheckBox Grid.Column="0"
                                      IsEnabled="{Binding DataContext.CanEditSettings, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                      IsChecked="{Binding Enabled, Mode=OneWay}"
                                      Command="{Binding DataContext.ToggleScheduledActionEnabledCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                      CommandParameter="{Binding}"
                                      VerticalAlignment="Center"
                                      ToolTip="Click to enable or disable this action immediately." />
                            <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                                       Width="150" ToolTip="{Binding Name}"
                                       FontWeight="SemiBold" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="{Binding Target}"
                                       ToolTip="{Binding Target}" Margin="8,0"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="3" Text="{Binding OffsetFromStart}"
                                       HorizontalAlignment="Right" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="4" Text="{Binding StatusText}"
                                       HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock Text="Click a list checkbox to enable/disable an action immediately. Other edits require Update Selected."
                       Foreground="Gray" TextWrapping="Wrap" Margin="0,0,0,8" />

            <Grid IsEnabled="{Binding CanEditSettings}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Name"
                           VerticalAlignment="Center" Margin="0,0,8,8" />
                <TextBox Grid.Row="0" Grid.Column="1" Margin="0,0,12,8"
                         Text="{Binding ActionName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Grid.Row="0" Grid.Column="2" Text="Type"
                           VerticalAlignment="Center" Margin="0,0,8,8" />
                <ComboBox Grid.Row="0" Grid.Column="3" Margin="0,0,0,8"
                          ItemsSource="{Binding ActionTypes}"
                          SelectedItem="{Binding SelectedActionType, Mode=TwoWay}" />

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Target"
                           VerticalAlignment="Center" Margin="0,0,8,8" />
                <Grid Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Margin="0,0,8,0"
                             Text="{Binding ActionTarget, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <Button Grid.Column="1" Content="Browse..." Padding="12,5"
                            IsEnabled="{Binding CanBrowseActionTarget}"
                            Command="{Binding BrowseActionTargetCommand}"
                            ToolTip="Select an executable, file or folder using Windows Explorer." />
                </Grid>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Offset (HH:MM:SS)"
                           VerticalAlignment="Center" Margin="0,0,8,8" />
                <TextBox Grid.Row="2" Grid.Column="1" Margin="0,0,12,8"
                         Text="{Binding ActionOffsetText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <CheckBox Grid.Row="2" Grid.Column="3" Content="Enabled"
                          IsChecked="{Binding ActionEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          ToolTip="For an existing action, click Update Selected to save this change."
                          VerticalAlignment="Center" Margin="0,0,0,8" />
            </Grid>

            <TextBlock Text="For an existing action, click Update Selected to save edits (including Enabled)."
                       Foreground="Gray" TextWrapping="Wrap" Margin="0,2,0,8" />

            <WrapPanel HorizontalAlignment="Right" Margin="0,4,0,0"
                       IsEnabled="{Binding CanEditSettings}">
                <Button Content="Clear" Padding="12,5" Margin="0,0,6,0"
                        Command="{Binding ClearActionEditorCommand}" />
                <Button Content="Add Action" Padding="12,5" Margin="0,0,6,0"
                        Command="{Binding AddScheduledActionCommand}" />
                <Button Content="Update Selected" Padding="12,5" Margin="0,0,6,0"
                        Command="{Binding UpdateScheduledActionCommand}" />
                <Button Content="Remove Selected" Padding="12,5"
                        Command="{Binding RemoveScheduledActionCommand}" />
            </WrapPanel>
        </StackPanel>
    </Border>
</UserControl>
