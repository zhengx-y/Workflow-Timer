<UserControl x:Class="Workflow_Timer.Views.MainWindowControls.ScheduledActionControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Workflow_Timer.Views.Controls"
             FontSize="12">
    <Border Style="{StaticResource WorkflowPanelFrame}" BorderThickness="1" CornerRadius="6"
            Padding="8" Margin="0,6,0,0">
        <Grid>
            <Grid.Resources>
                <BooleanToVisibilityConverter x:Key="ActionDraftVisibility"/>
            </Grid.Resources>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <DockPanel Grid.Row="0" Margin="0,0,0,5">
                <Button DockPanel.Dock="Right" Content="+" Width="30" MinWidth="0" MinHeight="24"
                        Padding="0" FontSize="16" ToolTip="Add a scheduled action"
                        IsEnabled="{Binding CanEditSettings}" Command="{Binding AddScheduledActionCommand}"/>
                <TextBlock Text="Scheduled Actions" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
            </DockPanel>
            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                          CanContentScroll="False" Margin="0,0,0,8">
                <Grid MinWidth="720" Margin="0,0,0,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="4,0,4,3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="45"/>
                            <ColumnDefinition Width="53"/>
                            <ColumnDefinition Width="132"/>
                            <ColumnDefinition Width="142"/>
                            <ColumnDefinition Width="76"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="On" FontWeight="SemiBold" Margin="2,0"/>
                        <TextBlock Grid.Column="1" Text="Delete" FontWeight="SemiBold" Margin="2,0"/>
                        <TextBlock Grid.Column="2" Text="Name" FontWeight="SemiBold" Margin="2,0"/>
                        <TextBlock Grid.Column="3" Text="Offset" FontWeight="SemiBold" Margin="2,0" ToolTip="HH:MM:SS"/>
                        <TextBlock Grid.Column="4" Text="Browse" FontWeight="SemiBold" Margin="2,0"/>
                        <TextBlock Grid.Column="5" Text="Path / URL" FontWeight="SemiBold" Margin="2,0"/>
                    </Grid>
                    <ListBox Grid.Row="1" ItemsSource="{Binding ScheduledActions}" MinHeight="55"
                             Padding="0" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.CanContentScroll="False"
                             HorizontalContentAlignment="Stretch">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="4,2,10,5" ToolTip="{Binding StatusText}">
                                    <Grid IsEnabled="{Binding DataContext.CanEditSettings, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="45"/>
                                            <ColumnDefinition Width="53"/>
                                            <ColumnDefinition Width="132"/>
                                            <ColumnDefinition Width="142"/>
                                            <ColumnDefinition Width="76"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <CheckBox IsChecked="{Binding Enabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  VerticalAlignment="Center" HorizontalAlignment="Left" Margin="4,0"
                                                  ToolTip="Enable or disable this action"/>
                                        <Button Grid.Column="1" Content="×" Padding="4,0" MinWidth="0" MinHeight="24" Margin="2,0"
                                                ToolTip="Delete action"
                                                Command="{Binding DataContext.RemoveScheduledActionCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                CommandParameter="{Binding}"/>
                                        <TextBox Grid.Column="2" Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 Margin="2,0" Padding="4,1" MinHeight="24" ToolTip="{Binding Name}"/>
                                        <controls:TimeSpinnerControl Grid.Column="3"
                                                 ShowArrows="False"
                                                 UseConstantFormat="True"
                                                 DurationText="{Binding OffsetText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 Margin="2,0" VerticalAlignment="Center"
                                                 LostKeyboardFocus="ActionOffsetLostFocus"/>
                                        <Button Grid.Column="4" Content="Browse…" Padding="4,1" MinWidth="0" MinHeight="24" Margin="2,0"
                                                Command="{Binding DataContext.BrowseActionTargetCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                CommandParameter="{Binding}"/>
                                        <TextBox Grid.Column="5" Text="{Binding Target, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 Margin="2,0" Padding="4,1" MinHeight="24" ToolTip="{Binding Target}"/>
                                    </Grid>
                                    <TextBlock Text="{Binding Error}" Foreground="{DynamicResource WorkflowWarningBrush}"
                                               TextWrapping="Wrap" Margin="2,4,0,3"
                                               Visibility="{Binding HasPendingChanges, Converter={StaticResource ActionDraftVisibility}}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </ScrollViewer>
            <TextBlock Grid.Row="2" Text="Edits save automatically. Scroll horizontally for longer targets."
                       Foreground="{DynamicResource WorkflowMutedBrush}" TextWrapping="Wrap" Margin="0,3,0,0"/>
            <TextBlock Grid.Row="3" Text="Resolve incomplete actions before starting the timer."
                       Foreground="{DynamicResource WorkflowWarningBrush}" TextWrapping="Wrap" Margin="0,4,0,0"
                       Visibility="{Binding HasUnsavedActionChanges, Converter={StaticResource ActionDraftVisibility}}"/>
        </Grid>
    </Border>
</UserControl>
