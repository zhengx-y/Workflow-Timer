<UserControl x:Class="Workflow_Timer.Views.MainWindowControls.ScheduledActionControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Workflow_Timer.Views.Controls"
             FontSize="13">
    <Border Style="{StaticResource WorkflowPanelFrame}" BorderThickness="1" CornerRadius="6"
            Padding="8" Margin="0,6,0,0">
        <Grid>
            <Grid.Resources>
                <BooleanToVisibilityConverter x:Key="ActionDraftVisibility"/>
            </Grid.Resources>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <DockPanel Grid.Row="0" Margin="0,0,0,5">
                <Button ToolTipService.InitialShowDelay="450" ToolTipService.ShowDuration="20000" ToolTipService.ShowOnDisabled="True" DockPanel.Dock="Right" Content="Add Action" Style="{StaticResource WorkflowPrimaryButton}"
                        Padding="12,4" ToolTip="Add an action to the selected preset. Stop the timer to edit actions."
                        IsEnabled="{Binding CanEditSettings}" Command="{Binding AddScheduledActionCommand}"/>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Style="{StaticResource WorkflowGuidanceDot}"
                             Visibility="{Binding ShowActionGuidance, Converter={StaticResource ActionDraftVisibility}}"/>
                    <TextBlock ToolTipService.InitialShowDelay="450" ToolTipService.ShowDuration="20000" ToolTipService.ShowOnDisabled="True" ToolTip="Decide which websites, files, folders or programs open automatically during a work session." Text="Scheduled Actions" FontSize="19" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>
            </DockPanel>
            <TextBlock Grid.Row="1" Text="{Binding DurationConflictMessage}"
                       Foreground="{DynamicResource WorkflowWarningBrush}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,4,0,8"
                       Visibility="{Binding HasDurationConflict, Converter={StaticResource ActionDraftVisibility}}"/>
            <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                          CanContentScroll="False" Margin="0,0,0,8">
                <Grid MinWidth="800" Margin="0,0,0,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="4,0,4,3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="85"/>
                            <ColumnDefinition Width="53"/>
                            <ColumnDefinition Width="132"/>
                            <ColumnDefinition Width="142"/>
                            <ColumnDefinition Width="76"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock ToolTipService.InitialShowDelay="450" ToolTipService.ShowDuration="20000" ToolTipService.ShowOnDisabled="True" ToolTip="Use the checkmark to enable or disable a scheduled action." Text="Activation" FontWeight="SemiBold" Margin="2,0"/>
                        <TextBlock ToolTipService.InitialShowDelay="450" ToolTipService.ShowDuration="20000" ToolTipService.ShowOnDisabled="True" ToolTip="Remove an action from the selected preset." Grid.Column="1" Text="Delete" FontWeight="SemiBold" Margin="2,0"/>
                        <TextBlock ToolTipService.InitialShowDelay="450" ToolTipService.ShowDuration="20000" ToolTipService.ShowOnDisabled="True" ToolTip="Give the action a recognizable name, such as Study notes." Grid.Column="2" Text="Name" FontWeight="SemiBold" Margin="2,0"/>
                        <TextBlock ToolTipService.InitialShowDelay="450" ToolTipService.ShowDuration="20000" ToolTipService.ShowOnDisabled="True" Grid.Column="3" Text="Start after:" FontWeight="SemiBold" Margin="2,0" ToolTip="The time offset after work starts. 00:05:00 opens the target five minutes into work; 00:00:00 opens it immediately."/>
                        <TextBlock ToolTipService.InitialShowDelay="450" ToolTipService.ShowDuration="20000" ToolTipService.ShowOnDisabled="True" ToolTip="Choose a file, program or folder from your computer." Grid.Column="4" Text="Browse" FontWeight="SemiBold" Margin="2,0"/>
                        <TextBlock ToolTipService.InitialShowDelay="450" ToolTipService.ShowDuration="20000" ToolTipService.ShowOnDisabled="True" ToolTip="Enter the website address or local file, folder or program path to open." Grid.Column="5" Text="Enter URL or Browse for Path" FontWeight="SemiBold" Margin="2,0"/>
                    </Grid>
                    <ListBox Grid.Row="1" ItemsSource="{Binding ScheduledActions}" MinHeight="200"
                             Padding="0" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Disabled"
                             ScrollViewer.CanContentScroll="False"
                             HorizontalContentAlignment="Stretch">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel ToolTipService.InitialShowDelay="450" ToolTipService.ShowDuration="20000" ToolTipService.ShowOnDisabled="True" Margin="4,2,10,5" ToolTip="{Binding StatusText}">
                                    <Grid IsEnabled="{Binding DataContext.CanEditSettings, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="85"/>
                                            <ColumnDefinition Width="53"/>
                                            <ColumnDefinition Width="132"/>
                                            <ColumnDefinition Width="142"/>
                                            <ColumnDefinition Width="76"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <CheckBox ToolTipService.InitialShowDelay="450" ToolTipService.ShowDuration="20000" ToolTipService.ShowOnDisabled="True" IsChecked="{Binding Enabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  VerticalAlignment="Center" HorizontalAlignment="Left" Margin="4,0"
                                                  ToolTip="Checked actions run automatically; unchecked actions are skipped."/>
                                        <Button ToolTipService.InitialShowDelay="450" ToolTipService.ShowDuration="20000" ToolTipService.ShowOnDisabled="True" Grid.Column="1" Content="×" Padding="4,0" MinWidth="0" MinHeight="24" Margin="2,0"
                                                ToolTip="Delete this scheduled action."
                                                Command="{Binding DataContext.RemoveScheduledActionCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                CommandParameter="{Binding}"/>
                                        <TextBox ToolTipService.InitialShowDelay="450" ToolTipService.ShowDuration="20000" ToolTipService.ShowOnDisabled="True" Grid.Column="2" Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 Margin="2,0" Padding="4,1" MinHeight="24">
                                            <TextBox.ToolTip>
                                                <ToolTip>
                                                    <StackPanel>
                                                        <TextBlock Text="Enter a descriptive name for this action." TextWrapping="Wrap"/>
                                                        <TextBlock Text="{Binding PlacementTarget.DataContext.Name, RelativeSource={RelativeSource AncestorType={x:Type ToolTip}}}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,5,0,0"/>
                                                    </StackPanel>
                                                </ToolTip>
                                            </TextBox.ToolTip>
                                        </TextBox>
                                        <controls:TimeSpinnerControl ToolTipService.InitialShowDelay="450" ToolTipService.ShowDuration="20000" ToolTipService.ShowOnDisabled="True" ToolTip="Set when this action launches, measured from the start of work." Grid.Column="3"
                                                 ShowArrows="False"
                                                 UseConstantFormat="True"
                                                 DurationText="{Binding OffsetText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 Margin="2,0" VerticalAlignment="Center"
                                                 LostKeyboardFocus="ActionOffsetLostFocus"/>
                                        <Button ToolTipService.InitialShowDelay="450" ToolTipService.ShowDuration="20000" ToolTipService.ShowOnDisabled="True" ToolTip="Select a local file, program or folder to open." Grid.Column="4" Content="Browse…" Padding="4,1" MinWidth="0" MinHeight="24" Margin="2,0"
                                                Command="{Binding DataContext.BrowseActionTargetCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                CommandParameter="{Binding}"/>
                                        <TextBox ToolTipService.InitialShowDelay="450" ToolTipService.ShowDuration="20000" ToolTipService.ShowOnDisabled="True" Grid.Column="5" Text="{Binding Target, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 Margin="2,0" Padding="4,1" MinHeight="24">
                                            <TextBox.ToolTip>
                                                <ToolTip>
                                                    <StackPanel>
                                                        <TextBlock Text="Type or paste a website URL or a local file, folder or program path." TextWrapping="Wrap"/>
                                                        <TextBlock Text="{Binding PlacementTarget.DataContext.Target, RelativeSource={RelativeSource AncestorType={x:Type ToolTip}}}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,5,0,0"/>
                                                    </StackPanel>
                                                </ToolTip>
                                            </TextBox.ToolTip>
                                        </TextBox>
                                    </Grid>
                                    <TextBlock Text="{Binding Error}" Foreground="{DynamicResource WorkflowWarningBrush}"
                                               TextWrapping="Wrap" Margin="2,4,0,3"
                                               Visibility="{Binding HasDisplayError, Converter={StaticResource ActionDraftVisibility}}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </ScrollViewer>
            <TextBlock ToolTipService.InitialShowDelay="450" ToolTipService.ShowDuration="20000" ToolTipService.ShowOnDisabled="True" ToolTip="Valid action changes are saved automatically." Grid.Row="3" Text="Edits save automatically."
                       Foreground="{DynamicResource WorkflowTimerAccentBrush}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,3,0,0"/>
            <TextBlock ToolTipService.InitialShowDelay="450" ToolTipService.ShowDuration="20000" ToolTipService.ShowOnDisabled="True" ToolTip="Fill in required action details or remove incomplete actions before starting." Grid.Row="4" Text="Resolve incomplete actions before starting the timer."
                       Foreground="{DynamicResource WorkflowWarningBrush}" TextWrapping="Wrap" Margin="0,4,0,0"
                       Visibility="{Binding HasOtherActionErrors, Converter={StaticResource ActionDraftVisibility}}"/>
        </Grid>
    </Border>
</UserControl>
