<UserControl x:Class="Workflow_Timer.Views.MainWindowControls.PresetControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border Style="{StaticResource WorkflowPanelFrame}"
            BorderThickness="1"
            CornerRadius="6"
            Padding="12"
            Margin="0,0,0,10">

        <StackPanel>
            <StackPanel.Resources>
                <BooleanToVisibilityConverter x:Key="UnsavedVisibility"/>
            </StackPanel.Resources>

            <DockPanel Margin="0,0,0,10">
                <Ellipse Style="{StaticResource WorkflowGuidanceDot}"
                         DockPanel.Dock="Left"
                         Visibility="{Binding ShowPresetGuidance, Converter={StaticResource UnsavedVisibility}}"/>
                <TextBlock ToolTipService.InitialShowDelay="450" ToolTipService.ShowDuration="20000" ToolTipService.ShowOnDisabled="True" ToolTip="Create reusable work routines with their own work duration, break duration and scheduled actions." Text="Preset Manager – What work do you have today?"
                       FontSize="20"
                       FontWeight="Bold" TextWrapping="Wrap"/>
            </DockPanel>

            <!-- Preset selection and management -->
            <Grid Margin="0,0,0,18" HorizontalAlignment="Left">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="240"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <ComboBox ToolTipService.InitialShowDelay="450" ToolTipService.ShowDuration="20000" ToolTipService.ShowOnDisabled="True" ToolTip="Select the saved routine you want to use. Stop the timer before changing presets." Grid.Column="0"
                          Margin="0,0,8,0"
                          MinHeight="30"
                          ItemsSource="{Binding Presets}"
                          DisplayMemberPath="Name"
                          SelectedItem="{Binding SelectedPreset, Mode=TwoWay}"/>

                <Button ToolTipService.InitialShowDelay="450" ToolTipService.ShowDuration="20000" ToolTipService.ShowOnDisabled="True" ToolTip="Create a new reusable routine with its own timer and scheduled actions." Grid.Column="1"
                        Content="New preset" Style="{StaticResource WorkflowPrimaryButton}"
                        Padding="12,5"
                        Margin="0,0,6,0"
                        Command="{Binding PresetCommands.CreatePresetCommand}"/>

                <Button ToolTipService.InitialShowDelay="450" ToolTipService.ShowDuration="20000" ToolTipService.ShowOnDisabled="True" ToolTip="Delete the selected preset." Grid.Column="2"
                        Content="Delete" Style="{StaticResource WorkflowDangerButton}"
                        Padding="12,5"
                        Command="{Binding PresetCommands.DeletePresetCommand}"/>
            </Grid>

            <!-- Editable preset settings -->
            <Grid HorizontalAlignment="Left">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="240"/>
                </Grid.ColumnDefinitions>

                <TextBlock ToolTipService.InitialShowDelay="450" ToolTipService.ShowDuration="20000" ToolTipService.ShowOnDisabled="True" ToolTip="Give this preset a recognizable name." Grid.Row="0"
                           Grid.Column="0"
                           Text="Name:"
                           VerticalAlignment="Center"
                           Margin="0,0,10,8"/>

                <TextBox ToolTipService.InitialShowDelay="450" ToolTipService.ShowDuration="20000" ToolTipService.ShowOnDisabled="True" ToolTip="Name this routine, for example Studying or Coding." Grid.Row="0"
                         Grid.Column="1"
                         MinHeight="28"
                         GotKeyboardFocus="PresetName_GotKeyboardFocus"
                         PreviewMouseLeftButtonDown="PresetName_PreviewMouseLeftButtonDown"
                         Margin="0,0,0,8"
                         Text="{Binding PresetNameDraft,
                                        Mode=TwoWay,
                                        UpdateSourceTrigger=PropertyChanged}"/>

            </Grid>
            <TextBlock ToolTipService.InitialShowDelay="450" ToolTipService.ShowDuration="20000" ToolTipService.ShowOnDisabled="True" ToolTip="Valid preset changes are saved without a Save button." Text="Changes save automatically." FontSize="15" FontWeight="SemiBold"
                       Foreground="{DynamicResource WorkflowTimerAccentBrush}" Margin="0,4,0,0"/>

        </StackPanel>
    </Border>
</UserControl>
