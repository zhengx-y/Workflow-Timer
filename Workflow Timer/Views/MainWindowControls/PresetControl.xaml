<UserControl x:Class="Workflow_Timer.Views.MainWindowControls.PresetControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Workflow_Timer.Views.Controls">

    <Border Style="{StaticResource WorkflowPanelFrame}"
            BorderThickness="1"
            CornerRadius="6"
            Padding="12"
            Margin="0,0,0,10">

        <StackPanel>
            <StackPanel.Resources>
                <BooleanToVisibilityConverter x:Key="UnsavedVisibility"/>
            </StackPanel.Resources>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <Ellipse Style="{StaticResource WorkflowGuidanceDot}"
                         Visibility="{Binding ShowPresetGuidance, Converter={StaticResource UnsavedVisibility}}"/>
                <TextBlock ToolTipService.InitialShowDelay="450" ToolTipService.ShowDuration="20000" ToolTipService.ShowOnDisabled="True" ToolTip="Create reusable work routines with their own work duration, break duration and scheduled actions." Text="Preset Manager"
                       FontSize="20"
                       FontWeight="Bold"/>
            </StackPanel>

            <!-- Preset selection and management -->
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <ComboBox ToolTipService.InitialShowDelay="450" ToolTipService.ShowDuration="20000" ToolTipService.ShowOnDisabled="True" ToolTip="Select the saved routine you want to use. Stop the timer before changing presets." Grid.Column="0"
                          Margin="0,0,8,0"
                          MinHeight="30"
                          ItemsSource="{Binding Presets}"
                          DisplayMemberPath="Name"
                          SelectedItem="{Binding SelectedPreset, Mode=TwoWay}"/>

                <Button ToolTipService.InitialShowDelay="450" ToolTipService.ShowDuration="20000" ToolTipService.ShowOnDisabled="True" ToolTip="Create a new reusable routine with its own timer and scheduled actions." Grid.Column="1"
                        Content="New preset" Style="{StaticResource WorkflowPrimaryButton}"
                        Padding="12,5"
                        Margin="0,0,6,0"
                        Command="{Binding PresetCommands.CreatePresetCommand}"/>

                <Button ToolTipService.InitialShowDelay="450" ToolTipService.ShowDuration="20000" ToolTipService.ShowOnDisabled="True" ToolTip="Delete the selected preset." Grid.Column="2"
                        Content="Delete" Style="{StaticResource WorkflowDangerButton}"
                        Padding="12,5"
                        Command="{Binding PresetCommands.DeletePresetCommand}"/>
            </Grid>

            <!-- Editable preset settings -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock ToolTipService.InitialShowDelay="450" ToolTipService.ShowDuration="20000" ToolTipService.ShowOnDisabled="True" ToolTip="Give this preset a recognizable name." Grid.Row="0"
                           Grid.Column="0"
                           Text="Name:"
                           VerticalAlignment="Center"
                           Margin="0,0,10,8"/>

                <TextBox ToolTipService.InitialShowDelay="450" ToolTipService.ShowDuration="20000" ToolTipService.ShowOnDisabled="True" ToolTip="Name this routine, for example Studying or Coding." Grid.Row="0"
                         Grid.Column="1"
                         Grid.ColumnSpan="3"
                         MinHeight="28"
                         Margin="0,0,0,8"
                         Text="{Binding PresetNameDraft,
                                        Mode=TwoWay,
                                        UpdateSourceTrigger=PropertyChanged}"/>

                <StackPanel Grid.Row="1" Grid.ColumnSpan="4" Orientation="Horizontal" Margin="0,0,0,8">
                    <StackPanel Margin="0,0,20,0">
                        <TextBlock ToolTipService.InitialShowDelay="450" ToolTipService.ShowDuration="20000" ToolTipService.ShowOnDisabled="True" ToolTip="Choose how long you intend to focus before the break begins." Text="Work duration" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <controls:TimeSpinnerControl ToolTipService.InitialShowDelay="450" ToolTipService.ShowDuration="20000" ToolTipService.ShowOnDisabled="True" ToolTip="Set the planned work time in hours, minutes and seconds." DurationText="{Binding PresetWorkDraft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock ToolTipService.InitialShowDelay="450" ToolTipService.ShowDuration="20000" ToolTipService.ShowOnDisabled="True" ToolTip="Choose how long to rest after work. Set zero to skip the break." Text="Break duration" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <controls:TimeSpinnerControl ToolTipService.InitialShowDelay="450" ToolTipService.ShowDuration="20000" ToolTipService.ShowOnDisabled="True" ToolTip="Set the break duration. 00:00:00 skips the break." DurationText="{Binding PresetBreakDraft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </StackPanel>

                <TextBlock Grid.Row="2"
                           Grid.Column="0"
                           Grid.ColumnSpan="4"
                           Text="Hours : minutes : seconds — scroll, use arrows, or click to type."
                           Foreground="{DynamicResource WorkflowMutedBrush}"
                           FontSize="13" TextWrapping="Wrap"/>
            </Grid>
            <TextBlock ToolTipService.InitialShowDelay="450" ToolTipService.ShowDuration="20000" ToolTipService.ShowOnDisabled="True" ToolTip="Valid preset changes are saved without a Save button." Text="Changes save automatically." FontSize="13"
                       Foreground="{DynamicResource WorkflowMutedBrush}" Margin="0,4,0,0"/>
            <TextBlock Text="{Binding PresetEditError}"
                       Foreground="{DynamicResource WorkflowWarningBrush}" FontWeight="SemiBold" TextWrapping="Wrap"
                       Margin="0,8,0,0"
                       Visibility="{Binding HasPresetEditError, Converter={StaticResource UnsavedVisibility}}"/>

        </StackPanel>
    </Border>
</UserControl>
