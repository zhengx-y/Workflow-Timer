<UserControl x:Class="Workflow_Timer.Views.MainWindowControls.HistoryControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="6" Padding="12">
        <StackPanel>
            <TextBlock Text="History &amp; Records" FontSize="19" FontWeight="Bold" Margin="0,0,0,14"/>

            <TextBlock Text="Today's work" Foreground="Gray"/>
            <TextBlock Text="{Binding TodayWorkText}" FontSize="27" FontWeight="SemiBold" Margin="0,0,0,12"/>

            <TextBlock Text="Personal best day" Foreground="Gray"/>
            <TextBlock Text="{Binding BestDayText}" FontSize="22" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding BestDayDateText}" Foreground="Gray"/>
            <TextBlock Text="{Binding RecordResetText}" Foreground="Gray" FontSize="11" Margin="0,2,0,7"/>
            <Button Content="Clear Personal Best" Command="{Binding ClearPersonalBestCommand}"
                    HorizontalAlignment="Left" Padding="10,5" Margin="0,0,0,14"/>

            <Separator Margin="0,0,0,12"/>
            <TextBlock Text="All recorded work" Foreground="Gray"/>
            <TextBlock Text="{Binding AllTimeWorkText}" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,14"/>

            <TextBlock Text="Daily totals" FontWeight="Bold" FontSize="15" Margin="0,0,0,5"/>
            <ListBox ItemsSource="{Binding DailyHistory}" MaxHeight="148"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     Margin="0,0,0,14">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="2,4" Width="295">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Detail}" Foreground="Gray" FontSize="11"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding Duration}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock Text="Recent sessions" FontWeight="Bold" FontSize="15" Margin="0,0,0,5"/>
            <ListBox ItemsSource="{Binding RecentHistory}" MaxHeight="320"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="2,5" Width="295">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="200"/>
                                <TextBlock Text="{Binding Detail}" Foreground="Gray" FontSize="11"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding Duration}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </StackPanel>
    </Border>
</UserControl>
