<UserControl x:Class="Workflow_Timer.Views.MainWindowControls.MotivationControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{StaticResource WorkflowPanelFrame}" Background="{DynamicResource WorkflowHistoryBrush}" BorderThickness="1" CornerRadius="6"
            Padding="12" Margin="0,0,0,10">
        <StackPanel>
            <DockPanel Margin="0,0,0,10" LastChildFill="True">
                <Button ToolTipService.InitialShowDelay="450" ToolTipService.ShowDuration="20000" ToolTipService.ShowOnDisabled="True" ToolTip="Display another motivational quote." DockPanel.Dock="Right" Content="Next quote" Style="{StaticResource WorkflowPrimaryButton}"
                        Padding="10,4" Margin="8,0,0,0"
                        Command="{Binding NextMotivationQuoteCommand}"/>
                <TextBlock ToolTipService.InitialShowDelay="450" ToolTipService.ShowDuration="20000" ToolTipService.ShowOnDisabled="True" ToolTip="Read inspirational quotes for encouragement and a fresh perspective." Text="Motivation" FontSize="18" FontWeight="Bold"
                           VerticalAlignment="Center"/>
            </DockPanel>
            <TextBlock Text="{Binding MotivationQuoteText}"
                       FontSize="16" FontStyle="Italic"
                       TextWrapping="Wrap" TextAlignment="Center"
                       Padding="2,4,2,6"/>
        </StackPanel>
    </Border>
</UserControl>
