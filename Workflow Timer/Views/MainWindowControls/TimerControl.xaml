<UserControl x:Class="Workflow_Timer.Views.MainWindowControls.TimerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="800">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
    </UserControl.Resources>

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" HorizontalAlignment="Center">
            <TextBlock Text="{Binding SelectedPreset.Name}"
                       FontSize="20" HorizontalAlignment="Center"/>
            <TextBlock Text="{Binding State}"
                       FontSize="14" HorizontalAlignment="Center"
                       Margin="0,5,0,0"/>
        </StackPanel>

        <TextBlock Grid.Row="1"
                   Text="{Binding RemainingTime, StringFormat={}{0:hh\:mm\:ss}}"
                   FontSize="72" FontWeight="Bold"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"/>

        <!-- Start/Stop swap places; Pause/Resume swap places. -->
        <WrapPanel Grid.Row="2" HorizontalAlignment="Center" Margin="0,10">
            <Button Content="Start"
                    Command="{Binding TimerCommands.StartCommand}"
                    Visibility="{Binding CanStartTimer, Converter={StaticResource BoolToVisibility}}"
                    Margin="5" Padding="18,8"/>

            <Button Content="Stop"
                    Command="{Binding TimerCommands.StopCommand}"
                    Visibility="{Binding HasActiveTimer, Converter={StaticResource BoolToVisibility}}"
                    Margin="5" Padding="18,8"/>

            <Button Content="Pause"
                    Command="{Binding TimerCommands.PauseCommand}"
                    Visibility="{Binding CanPauseTimer, Converter={StaticResource BoolToVisibility}}"
                    Margin="5" Padding="18,8"/>

            <Button Content="Resume"
                    Command="{Binding TimerCommands.ResumeCommand}"
                    Visibility="{Binding CanResumeTimer, Converter={StaticResource BoolToVisibility}}"
                    Margin="5" Padding="18,8"/>

            <Button Content="Repeat"
                    Command="{Binding TimerCommands.RepeatCommand}"
                    Visibility="{Binding CanRepeatTimer, Converter={StaticResource BoolToVisibility}}"
                    Margin="5" Padding="18,8"/>
        </WrapPanel>

        <!-- Extensions remain visible but unavailable when no countdown is active. -->
        <WrapPanel Grid.Row="3" HorizontalAlignment="Center" Margin="0,10,0,0">
            <Button Content="+3 min" Command="{Binding TimerCommands.ExtendCommand}"
                    CommandParameter="3" IsEnabled="{Binding CanExtendTimer}"
                    Margin="5" Padding="15,7"/>
            <Button Content="+5 min" Command="{Binding TimerCommands.ExtendCommand}"
                    CommandParameter="5" IsEnabled="{Binding CanExtendTimer}"
                    Margin="5" Padding="15,7"/>
            <Button Content="+10 min" Command="{Binding TimerCommands.ExtendCommand}"
                    CommandParameter="10" IsEnabled="{Binding CanExtendTimer}"
                    Margin="5" Padding="15,7"/>
            <Button Content="+30 min" Command="{Binding TimerCommands.ExtendCommand}"
                    CommandParameter="30" IsEnabled="{Binding CanExtendTimer}"
                    Margin="5" Padding="15,7"/>
            <Button Content="+1 h" Command="{Binding TimerCommands.ExtendCommand}"
                    CommandParameter="60" IsEnabled="{Binding CanExtendTimer}"
                    Margin="5" Padding="15,7"/>
        </WrapPanel>
    </Grid>
</UserControl>
