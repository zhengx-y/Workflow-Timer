<UserControl x:Class="Workflow_Timer.Views.MainWindowControls.TimerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Workflow_Timer.Views"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="800">

    <Grid Margin="30">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Session information -->
        <StackPanel Grid.Row="0"
                    HorizontalAlignment="Center">

            <TextBlock Text="{Binding SelectedPreset.Name}"
                       FontSize="20"
                       HorizontalAlignment="Center"/>

            <TextBlock Text="{Binding State}"
                       FontSize="14"
                       HorizontalAlignment="Center"
                       Margin="0,5,0,0"/>
        </StackPanel>

        <!-- Main countdown -->
        <TextBlock Grid.Row="1"
                   Text="{Binding RemainingTime, StringFormat={}{0:hh\\:mm\\:ss}}"
                   FontSize="72"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"/>

        <!-- Main timer controls -->
        <WrapPanel Grid.Row="2"
                   HorizontalAlignment="Center"
                   Margin="0,10">

            <Button Content="Start"
                    Command="{Binding TimerCommands.StartCommand}"
                    Margin="5"
                    Padding="18,8"/>

            <Button Content="Pause"
                    Command="{Binding TimerCommands.PauseCommand}"
                    Margin="5"
                    Padding="18,8"/>

            <Button Content="Resume"
                    Command="{Binding TimerCommands.ResumeCommand}"
                    Margin="5"
                    Padding="18,8"/>

            <Button Content="Stop"
                    Command="{Binding TimerCommands.StopCommand}"
                    Margin="5"
                    Padding="18,8"/>

            <Button Content="Repeat"
                    Command="{Binding TimerCommands.RepeatCommand}"
                    Margin="5"
                    Padding="18,8"/>
        </WrapPanel>

        <!-- Extension controls -->
        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="0,10,0,0">

            <Button Content="+3 min"
                    Command="{Binding TimerCommands.ExtendCommand}"
                    CommandParameter="3"
                    Margin="5"
                    Padding="15,7"/>

            <Button Content="+5 min"
                    Command="{Binding TimerCommands.ExtendCommand}"
                    CommandParameter="5"
                    Margin="5"
                    Padding="15,7"/>
        </StackPanel>

    </Grid>
</UserControl>