<Window x:Class="Workflow_Timer.Views.TutorialView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Workflow Timer — Introduction and Tutorial"
        Icon="pack://application:,,,/Resources/Icons/Workflow_Timer.ico"
        Background="{DynamicResource WorkflowWindowBrush}" Foreground="{DynamicResource WorkflowTextBrush}"
        FontSize="15" Width="680" Height="720" MinWidth="460" MinHeight="380"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel Margin="20">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
            <TextBlock Text="WELCOME TO WORKFLOW TIMER" FontSize="12" FontWeight="Bold"
                       Foreground="{DynamicResource WorkflowTimerAccentBrush}"/>
            <TextBlock Text="Build your own workflow." FontSize="28" FontWeight="Bold" TextWrapping="Wrap"/>
            <TextBlock Text="I walked so you can run, using this app." FontStyle="Italic"
                       Foreground="{DynamicResource WorkflowMutedBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
            <TextBlock x:Name="ErrorText" Foreground="{DynamicResource WorkflowErrorBrush}" TextWrapping="Wrap"/>
            <DockPanel LastChildFill="False">
                <CheckBox x:Name="NeverShowCheck" Content="Never show again" VerticalAlignment="Center"/>
                <Button DockPanel.Dock="Right" Content="OK" MinWidth="100" IsDefault="True"
                        Style="{StaticResource WorkflowPrimaryButton}" Click="Ok_Click"/>
            </DockPanel>
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,10,0">
                <TextBlock Text="Workflow Timer combines focused work, deliberate breaks and timed automation in one place. Use it for studying, programming, creative projects or any routine you want to repeat."
                           TextWrapping="Wrap" Margin="0,0,0,14"/>
                <Border Background="{DynamicResource WorkflowPanelBrush}" BorderBrush="{DynamicResource WorkflowCardBorderBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="The philosophy behind Workflow Timer" FontSize="19" FontWeight="Bold"
                                   Foreground="{DynamicResource WorkflowTimerAccentBrush}" TextWrapping="Wrap"/>
                        <TextBlock Text="Reduce friction" FontWeight="SemiBold" Margin="0,12,0,4"/>
                        <TextBlock Text="Inspired by James Clear’s Atomic Habits, the idea is to make the desired action easier to perform. Decide what you want to accomplish, when to do it and which tools you need before you start. Clear goals, reusable presets and scheduled actions reduce the number of decisions you need to make while working, leaving fewer opportunities for distraction."
                                   TextWrapping="Wrap"/>
                        <TextBlock Text="Make a promise to yourself" FontWeight="SemiBold" Margin="0,12,0,4"/>
                        <TextBlock Text="Instead of telling yourself ‘I’ll start in five minutes,’ commit to working for a specific amount of time. You do not have to finish everything in one session. Honor the time you set aside, then take a deliberate break. Start with a duration you can realistically commit to."
                                   TextWrapping="Wrap"/>
                        <TextBlock Text="Get the ball rolling" FontWeight="SemiBold" Margin="0,12,0,4"/>
                        <TextBlock Text="Think of momentum like a ball: getting it rolling takes effort, but once it is moving, keeping it going becomes easier. Workflow Timer helps with that first push by turning your intentions into a clear, ready-to-start routine. The app cannot do the work for you, but it can make starting simpler."
                                   TextWrapping="Wrap"/>
                        <TextBlock Text="Plan before you begin. Commit to the time. Build momentum." FontWeight="SemiBold"
                                   Foreground="{DynamicResource WorkflowTimerAccentBrush}" TextWrapping="Wrap" Margin="0,12,0,0"/>
                    </StackPanel>
                </Border>
                <Border Background="{DynamicResource WorkflowPanelBrush}" BorderBrush="{DynamicResource WorkflowCardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,8"><StackPanel><TextBlock Text="1. Configure a preset" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource WorkflowTimerAccentBrush}"/><TextBlock Text="Create or choose a preset. Set the work and break durations using the hour, minute and second fields. Scroll over a field or click it to type a value. Changes save automatically." TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel></Border>
                <Border Background="{DynamicResource WorkflowPanelBrush}" BorderBrush="{DynamicResource WorkflowCardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,8"><StackPanel><TextBlock Text="2. Automate your session" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource WorkflowTimerAccentBrush}"/><TextBlock Text="Add Action lets you schedule a file, executable, folder or website to open at an elapsed-time offset during work. Browse for a local target or type a URL. Use the checkbox to enable or disable an action." TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel></Border>
                <Border Background="{DynamicResource WorkflowPanelBrush}" BorderBrush="{DynamicResource WorkflowCardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,8"><StackPanel><TextBlock Text="3. Organize your tasks" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource WorkflowTimerAccentBrush}"/><TextBlock Text="Use the task panel to list what you want to accomplish. Add tasks and mark them complete as you work." TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel></Border>
                <Border Background="{DynamicResource WorkflowPanelBrush}" BorderBrush="{DynamicResource WorkflowCardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,8"><StackPanel><TextBlock Text="4. Start focusing" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource WorkflowTimerAccentBrush}"/><TextBlock Text="Start the timer and work through your tasks. Pause, resume, stop or extend when needed. The floating widget shows your countdown and next action; you can drag, minimize or expand it." TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel></Border>
                <Border Background="{DynamicResource WorkflowPanelBrush}" BorderBrush="{DynamicResource WorkflowCardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,8"><StackPanel><TextBlock Text="5. Take a break" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource WorkflowTimerAccentBrush}"/><TextBlock Text="Use the break timer to rest. Focus Reminder can help you return to work when your break ends. Review your completed sessions in Recent Sessions." TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel></Border>
                <Border Background="{DynamicResource WorkflowPanelBrush}" BorderBrush="{DynamicResource WorkflowCardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,8"><StackPanel><TextBlock Text="6. Make it yours" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource WorkflowTimerAccentBrush}"/><TextBlock Text="Open Settings to customize widget position and visibility, sounds, focus reminders, keyboard shortcuts and startup. Switch themes from the main window. Reopen this guide from Settings whenever you need it." TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel></Border>
                <Border Background="{DynamicResource WorkflowTasksBrush}" CornerRadius="8" Padding="14" Margin="0,4,0,0">
                    <StackPanel>
                        <TextBlock Text="Example: 45-minute study session" FontSize="17" FontWeight="Bold" TextWrapping="Wrap"/>
                        <TextBlock Text="Set work to 45 minutes and break to 10 minutes. Add your study tasks, schedule your notes folder at 00:00:00 and a reference website at 00:15:00. Start the timer, focus on your tasks, then take your break."
                                   TextWrapping="Wrap" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
