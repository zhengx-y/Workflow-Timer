<Window x:Class="Workflow_Timer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Workflow_Timer.Views.MainWindowControls"
        Title="Workflow Timer"
        Width="900"
        Height="600"
        MinWidth="650"
        MinHeight="400">

    <Grid Margin="10">

        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <views:TimerControl Grid.Row="0"/>

        <views:ScheduledActionControl Grid.Row="1"/>

    </Grid>

</Window>