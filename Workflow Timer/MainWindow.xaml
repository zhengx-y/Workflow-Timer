<Window x:Class="Workflow_Timer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Workflow_Timer.Views.MainWindowControls"
        Title="Workflow Timer"
        Background="{DynamicResource WorkflowWindowBrush}"
        Foreground="{DynamicResource WorkflowTextBrush}"
        Icon="pack://application:,,,/Resources/Icons/Workflow_Timer.ico"
        Width="1120" Height="800"
        MinWidth="1120" MinHeight="600">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="ReminderVisibility"/>
    </Window.Resources>
    <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="10,10,10,0" LastChildFill="False">
            <Button DockPanel.Dock="Right" Content="Settings..." Padding="12,5"
                    IsEnabled="{Binding CanEditSettings}" Click="SettingsButton_Click"/>
            <Button x:Name="RightPanelButton" DockPanel.Dock="Right" Content="Hide history / motivation"
                    Margin="0,0,8,0" Padding="10,5" Click="ToggleRightPanel_Click"/>
            <Button x:Name="LeftPanelButton" DockPanel.Dock="Left" Content="Hide tasks"
                    Padding="10,5" Click="ToggleLeftPanel_Click"/>
        </DockPanel>
        <Border DockPanel.Dock="Top" Margin="10,8,10,0" Padding="12"
                BorderThickness="1"
                CornerRadius="6"
                Visibility="{Binding IsFocusReminderVisible, Converter={StaticResource ReminderVisibility}}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="#FFF4D6"/>
                    <Setter Property="BorderBrush" Value="#C99C35"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsFocusReminderBlinkOn}" Value="True">
                            <Setter Property="Background" Value="#FFD36B"/>
                            <Setter Property="BorderBrush" Value="#A66600"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel>
                <TextBlock Text="Break is over!" FontSize="19" FontWeight="SemiBold" Foreground="#322710"/>
                <TextBlock Text="Time to get back to work." Margin="0,3,0,8" Foreground="#322710"/>
                <WrapPanel>
                    <Button Content="Start work" Command="{Binding TimerCommands.StartCommand}"
                            Padding="14,6" Margin="0,0,8,0"/>
                    <Button Content="{Binding SnoozeReminderText}" Command="{Binding SnoozeReminderCommand}"
                            Padding="14,6" Margin="0,0,8,0"/>
                    <Button Content="Dismiss" Command="{Binding DismissReminderCommand}"
                            IsEnabled="{Binding IsFocusReminderAttentionActive}" Padding="14,6" Margin="0,0,8,0"/>
                    <Button Content="Cancel Reminder" Command="{Binding CancelReminderCommand}" Padding="14,6"/>
                </WrapPanel>
                <TextBlock Text="{Binding FocusReminderIntervalText}" Margin="0,6,0,0" Foreground="#57491F"/>
            </StackPanel>
        </Border>
        <!-- Three independently scrolling areas with two resizable side columns. -->
        <Grid x:Name="PanelGrid" Margin="10,10,10,10" SizeChanged="PanelGrid_SizeChanged">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LeftPanelColumn" Width="220" MinWidth="220" MaxWidth="480"/>
                <ColumnDefinition x:Name="LeftSplitterColumn" Width="8"/>
                <ColumnDefinition Width="*" MinWidth="500"/>
                <ColumnDefinition x:Name="RightSplitterColumn" Width="8"/>
                <ColumnDefinition x:Name="RightPanelColumn" Width="320" MinWidth="320" MaxWidth="550"/>
            </Grid.ColumnDefinitions>
            <views:TodoControl x:Name="LeftPanel" Grid.Column="0" DataContext="{Binding Todo}"/>
            <GridSplitter x:Name="LeftSplitter" Grid.Column="1" Width="6" HorizontalAlignment="Center"
                          VerticalAlignment="Stretch" ResizeDirection="Columns"
                          ResizeBehavior="PreviousAndNext" Background="{DynamicResource WorkflowSplitterBrush}"
                          ShowsPreview="True"/>
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      CanContentScroll="False">
                <StackPanel Margin="0,0,0,10">
                    <views:PresetControl IsEnabled="{Binding CanEditSettings}"/>
                    <views:TimerControl/>
                    <views:ScheduledActionControl/>
                </StackPanel>
            </ScrollViewer>
            <GridSplitter x:Name="RightSplitter" Grid.Column="3" Width="6" HorizontalAlignment="Center"
                          VerticalAlignment="Stretch" ResizeDirection="Columns"
                          ResizeBehavior="PreviousAndNext" Background="{DynamicResource WorkflowSplitterBrush}"
                          ShowsPreview="True"/>
            <ScrollViewer x:Name="RightPanel" Grid.Column="4"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          CanContentScroll="False">
                <StackPanel VerticalAlignment="Top">
                    <views:MotivationControl/>
                    <views:HistoryControl/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>
