<Window x:Class="Workflow_Timer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Workflow_Timer.Views.MainWindowControls"
        Title="Workflow Timer"
        Width="1000" Height="740"
        MinWidth="1000" MinHeight="550">

    <!-- Outer scrolling keeps both columns reachable on smaller displays. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  CanContentScroll="False">
        <Grid Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="350"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                <views:PresetControl IsEnabled="{Binding CanEditSettings}"/>
                <views:TimerControl/>
                <views:ScheduledActionControl/>
            </StackPanel>

            <views:HistoryControl Grid.Column="1" VerticalAlignment="Top"/>
        </Grid>
    </ScrollViewer>
</Window>
