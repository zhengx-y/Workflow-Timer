<Window x:Class="Workflow_Timer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Workflow_Timer.Views.MainWindowControls"
        xmlns:controls="clr-namespace:Workflow_Timer.Views.Controls"
        Title="Workflow Timer"
        Background="{DynamicResource WorkflowWindowBrush}"
        Foreground="{DynamicResource WorkflowTextBrush}"
        FontSize="14"
        Icon="pack://application:,,,/Resources/Icons/Workflow_Timer.ico"
        Width="1200" Height="900"
        WindowStartupLocation="Manual"
        MinWidth="1200" MinHeight="700">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="ReminderVisibility"/>
    </Window.Resources>
    <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="10,10,10,0" LastChildFill="False">
            <Button ToolTipService.InitialShowDelay="450" ToolTipService.ShowDuration="20000" ToolTipService.ShowOnDisabled="True" ToolTip="Configure appearance, widget, reminders, sounds and shortcuts. Stop the timer before editing settings." DockPanel.Dock="Right" Content="Settings..." Padding="12,5" Style="{StaticResource WorkflowPrimaryButton}"
                    IsEnabled="{Binding CanEditSettings}" Click="SettingsButton_Click"/>
            <Button ToolTipService.InitialShowDelay="450" ToolTipService.ShowDuration="20000" ToolTipService.ShowOnDisabled="True" DockPanel.Dock="Right" Content="{Binding ThemeToggleText}" Command="{Binding ToggleThemeCommand}"
                    ToolTip="Switch between light and dark appearance immediately." Margin="0,0,8,0" Padding="10,5"/>
            <Button ToolTipService.InitialShowDelay="450" ToolTipService.ShowDuration="20000" ToolTipService.ShowOnDisabled="True" ToolTip="Show or hide the history and motivation panel." x:Name="RightPanelButton" DockPanel.Dock="Right" Content="Hide history / motivation"
                    Margin="0,0,8,0" Padding="10,5" Click="ToggleRightPanel_Click"/>
            <Button ToolTipService.InitialShowDelay="450" ToolTipService.ShowDuration="20000" ToolTipService.ShowOnDisabled="True" ToolTip="Show or hide your to-do list." x:Name="LeftPanelButton" DockPanel.Dock="Left" Content="Hide tasks"
                    Padding="10,5" Click="ToggleLeftPanel_Click"/>
        </DockPanel>
        <Border DockPanel.Dock="Top" Margin="10,8,10,0" Padding="12"
                BorderThickness="1"
                CornerRadius="6"
                Visibility="{Binding IsFocusReminderVisible, Converter={StaticResource ReminderVisibility}}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{DynamicResource WorkflowFocusBannerBrush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource WorkflowFocusBannerBorderBrush}"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsFocusReminderBlinkOn}" Value="True">
                            <Setter Property="Background" Value="{DynamicResource WorkflowFocusBannerBlinkBrush}"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource WorkflowFocusBannerBlinkBorderBrush}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel>
                <TextBlock ToolTipService.InitialShowDelay="450" ToolTipService.ShowDuration="20000" ToolTipService.ShowOnDisabled="True" ToolTip="Your break has ended. Start another work session or postpone the reminder." Text="Break is over!" FontSize="19" FontWeight="SemiBold" Foreground="{DynamicResource WorkflowFocusBannerTextBrush}"/>
                <TextBlock Text="Time to get back to work." Margin="0,3,0,8" Foreground="{DynamicResource WorkflowFocusBannerTextBrush}"/>
                <WrapPanel>
                    <Button ToolTipService.InitialShowDelay="450" ToolTipService.ShowDuration="20000" ToolTipService.ShowOnDisabled="True" ToolTip="Start a new work session using the selected preset." Content="Start work" Command="{Binding TimerCommands.StartCommand}" Style="{StaticResource WorkflowPrimaryButton}"
                            Padding="14,6" Margin="0,0,8,0"/>
                    <Button ToolTipService.InitialShowDelay="450" ToolTipService.ShowDuration="20000" ToolTipService.ShowOnDisabled="True" ToolTip="Postpone the reminder for the snooze duration in Settings." Content="{Binding SnoozeReminderText}" Command="{Binding SnoozeReminderCommand}"
                            Padding="14,6" Margin="0,0,8,0"/>
                    <Button ToolTipService.InitialShowDelay="450" ToolTipService.ShowDuration="20000" ToolTipService.ShowOnDisabled="True" ToolTip="Stop the current alert temporarily. Future reminders can still appear." Content="Dismiss" Command="{Binding DismissReminderCommand}"
                            IsEnabled="{Binding IsFocusReminderAttentionActive}" Padding="14,6" Margin="0,0,8,0"/>
                    <Button ToolTipService.InitialShowDelay="450" ToolTipService.ShowDuration="20000" ToolTipService.ShowOnDisabled="True" ToolTip="Stop reminders until the next completed session." Content="Cancel Reminder" Command="{Binding CancelReminderCommand}" Padding="14,6"/>
                </WrapPanel>
                <TextBlock Text="{Binding FocusReminderIntervalText}" Margin="0,6,0,0" Foreground="{DynamicResource WorkflowFocusBannerMutedBrush}"/>
            </StackPanel>
        </Border>
        <!-- Three independently scrolling areas with two resizable side columns. -->
        <Grid x:Name="PanelGrid" Margin="10,10,10,10" SizeChanged="PanelGrid_SizeChanged">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LeftPanelColumn" Width="220" MinWidth="220" MaxWidth="480"/>
                <ColumnDefinition x:Name="LeftSplitterColumn" Width="8"/>
                <ColumnDefinition Width="*" MinWidth="500"/>
                <ColumnDefinition x:Name="RightSplitterColumn" Width="8"/>
                <ColumnDefinition x:Name="RightPanelColumn" Width="320" MinWidth="320" MaxWidth="550"/>
            </Grid.ColumnDefinitions>
            <views:TodoControl x:Name="LeftPanel" Grid.Column="0" DataContext="{Binding Todo}"/>
            <GridSplitter ToolTipService.InitialShowDelay="450" ToolTipService.ShowDuration="20000" ToolTipService.ShowOnDisabled="True" ToolTip="Drag to change the width of the task panel." x:Name="LeftSplitter" Grid.Column="1" Width="6" HorizontalAlignment="Center"
                          VerticalAlignment="Stretch" ResizeDirection="Columns"
                          ResizeBehavior="PreviousAndNext" Background="{DynamicResource WorkflowSplitterBrush}"
                          ShowsPreview="True"/>
            <Grid Grid.Column="2" Margin="0,0,0,10" Background="{DynamicResource WorkflowWindowBrush}">
                    <ScrollViewer x:Name="CenterScrollViewer"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  CanContentScroll="False">
                        <StackPanel>
                            <views:PresetControl IsEnabled="{Binding CanEditSettings}"/>
                            <views:TimerControl/>
                            <Border Style="{StaticResource WorkflowPanelFrame}" BorderThickness="1" CornerRadius="6"
                                    Padding="12" Margin="0,0,0,6" IsEnabled="{Binding CanEditSettings}">
                                <StackPanel>
                                    <WrapPanel>
                                        <StackPanel Margin="0,0,20,0">
                                            <TextBlock Text="Work duration" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,6"
                                                       ToolTip="Choose how long you intend to focus before the break begins." ToolTipService.ShowOnDisabled="True"/>
                                            <controls:TimeSpinnerControl DurationText="{Binding PresetWorkDraft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                         ToolTip="Set the planned work time in hours, minutes and seconds." ToolTipService.ShowOnDisabled="True"/>
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="Break duration" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,6"
                                                       ToolTip="Choose how long to rest after work. Set zero to skip the break." ToolTipService.ShowOnDisabled="True"/>
                                            <controls:TimeSpinnerControl DurationText="{Binding PresetBreakDraft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                         ToolTip="Set the break duration. 00:00:00 skips the break." ToolTipService.ShowOnDisabled="True"/>
                                        </StackPanel>
                                    </WrapPanel>
                                    <TextBlock Text="Changes save automatically." FontSize="15" FontWeight="SemiBold"
                                               Foreground="{DynamicResource WorkflowTimerAccentBrush}" Margin="0,8,0,0"/>
                                    <TextBlock Text="{Binding VisiblePresetEditError}" Foreground="{DynamicResource WorkflowWarningBrush}"
                                               FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,4,0,0"
                                               Visibility="{Binding HasVisiblePresetEditError, Converter={StaticResource ReminderVisibility}}"/>
                                </StackPanel>
                            </Border>
                            <views:ScheduledActionControl PreviewMouseWheel="Scheduler_PreviewMouseWheel"/>
                        </StackPanel>
                    </ScrollViewer>
            </Grid>
            <GridSplitter ToolTipService.InitialShowDelay="450" ToolTipService.ShowDuration="20000" ToolTipService.ShowOnDisabled="True" ToolTip="Drag to change the width of the history and motivation panel." x:Name="RightSplitter" Grid.Column="3" Width="6" HorizontalAlignment="Center"
                          VerticalAlignment="Stretch" ResizeDirection="Columns"
                          ResizeBehavior="PreviousAndNext" Background="{DynamicResource WorkflowSplitterBrush}"
                          ShowsPreview="True"/>
            <ScrollViewer x:Name="RightPanel" Grid.Column="4"
                          Background="{DynamicResource WorkflowHistoryBrush}"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          CanContentScroll="False">
                <StackPanel VerticalAlignment="Top">
                    <views:MotivationControl/>
                    <views:HistoryControl/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>
